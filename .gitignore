# Godot 4.x editor cache and imported/generated metadata.
.godot/

# Generated platform projects and exported builds.
/android/
/build/
/builds/
/dist/
/exports/
/exported/
/web-build/

# Per-user editor/export state. Keep project.godot and export_presets.cfg.
/export.cfg

# Local game saves, logs, temporary files, and crash dumps.
*.save
*.sav
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*.dump
*.stackdump

# Local secrets/environment overrides. Keep safe example templates.
.env
.env.*
!.env.example
!.env.*.example

# Operating-system detritus.
.DS_Store
Thumbs.db
desktop.ini
